# ================================================================
# VideoForge AI — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.
# ================================================================

# ── Application ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:3001
API_BASE_URL=http://localhost:3000/api/v1

# ── Database ─────────────────────────────────────────────────────
# Local dev (Docker Compose):
MONGODB_URI=mongodb://root:rootpassword@localhost:27017/videoforge?authSource=admin
# Production: use MongoDB Atlas connection string with TLS

# ── Queue / Cache ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Production: use managed Redis with TLS e.g. redis://:<password>@host:6380

# ── Authentication ────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX_SECRET
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Credential Encryption (BYOK) ──────────────────────────────────
# Local fallback key — 32-byte hex. Use AWS KMS in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_KEY
# Set to 'true' to use AWS KMS for envelope encryption (recommended for prod)
USE_KMS=false

# ── AWS ───────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_S3_BUCKET=videoforge-assets-dev
AWS_KMS_KEY_ID=REPLACE_WITH_KMS_KEY_ARN_OR_ALIAS
# In production, use IAM roles / workload identity instead of static keys
AWS_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY

# ── Email ─────────────────────────────────────────────────────────
EMAIL_FROM=noreply@videoforge.io
# Supported: resend, sendgrid, smtp
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=REPLACE_WITH_EMAIL_API_KEY
# SMTP fallback (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Frontend ──────────────────────────────────────────────────────
# Next.js public URL (used for email links, CORS)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=debug
# Optional Sentry DSN for error tracking
SENTRY_DSN=

# ── Worker ────────────────────────────────────────────────────────
WORKER_CONCURRENCY_SCRIPT=5
WORKER_CONCURRENCY_VIDEO_GENERATION=10
WORKER_CONCURRENCY_STATUS_POLL=20
WORKER_CONCURRENCY_DOWNLOAD=10
WORKER_CONCURRENCY_RENDER=3
WORKER_MAX_POLLING_SECONDS=3600
WORKER_POLLING_INTERVAL_SECONDS=15

# ── Admin ─────────────────────────────────────────────────────────
# Initial admin account created on first boot
BOOTSTRAP_ADMIN_EMAIL=admin@videoforge.io
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
