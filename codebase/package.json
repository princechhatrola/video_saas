{
  "name": "videoforge-ai",
  "version": "0.0.1",
  "private": true,
  "description": "VideoForge AI – Multi-provider BYOK AI Video Generator SaaS",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:worker": "npm run dev --workspace=apps/worker",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "build:api": "npm run build --workspace=apps/api",
    "build:worker": "npm run build --workspace=apps/worker",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "build:shared": "npm run build --workspace=packages/shared-types",
    "build:sdk": "npm run build --workspace=packages/provider-sdk",
    "build:all": "npm run build:shared && npm run build:sdk && npm run build:api && npm run build:worker && npm run build:frontend",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
